  "editorialPolicy": {
    "brandIdentity": "仙加味為現代漢方生活品牌，以龜鹿系列專業與中藥製造產業背景為核心；不塑造成有藥櫃或抓藥服務的傳統中藥店。",
    "location": "一般貼文不刻意強調街道；品牌歷史涉及地點時依可核實資料表述。",
    "knowledge": "每篇獨立介紹一種原料或一個知識主題；與品牌置頂及正式商品貼文分開。題材可涵蓋菊花、枸杞、紅棗、桂圓、食品、工藝、文化、產業等，不表示仙加味有販售或使用該原料。",
    "commerce": "可供應的其他商品可客觀介紹並引導至官方 LINE 詢問；實際商品、供貨、法定販售資格與價格須核實。",
    "safety": "不暗示所有商品自行製造，不宣稱未核實的許可、產地、來源、療效；不把原料任意配成茶包、配方或不存在的商品。",
    "review": "知識候選題須完成查證、專屬圖片與人工審核後才能發布。",
    "claimsAndNames": "知識貼文不得自行創造或使用「瘦身茶」「排毒茶」「降血糖茶」「降血脂茶」「助眠茶」「睡眠茶」等暗示特定功效的配方名稱。若原廠商品正式名稱含此類字眼，先核對商品法定類別、標示、許可與台灣現行廣告規範，未核實不得對外宣傳；不得擅改原廠正式品名。 社群案例中「輕盈茶」「身材管理」「大餐後罪惡感」「要輕盈，更要養」等字句若與配方茶飲同時呈現，應以整體廣告效果聯想審查，不可僅因未明寫減重就自動放行。",
    "officialRegulatoryReference": {
      "title": "食品及相關產品標示宣傳廣告涉及不實誇張易生誤解或醫療效能認定準則",
      "url": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=L0040140",
      "checkedDate": "2026-10-21",
      "keyArticles": [
        "第3條：品名、文字、圖案、影像等依整體表現綜合判斷",
        "第4條：不實、無證據、改變人體功能或外觀等可能涉及誇張或易生誤解",
        "第5條：食品不得宣稱疾病相關或中藥材效能"
      ]
    },
    "officialRegulatoryBasis": {
      "source": "衛生福利部食品藥物管理署／食品標示諮詢服務平台",
      "url": "https://foodlabel.fda.gov.tw/FdaFrontEndApp/Law/Edit?SystemId=6f89ebe6-4db4-499a-829d-ab2b6a2e9875&clPublishStatus=1",
      "rule": "食品廣告依品名、文字、圖像、影音及其他訊息整體表現判斷；不得不實、誇張、易生誤解或宣稱醫療效能；涉及中藥材效能亦列為醫療效能認定情形。",
      "checkedDate": "2026-10-21"
    },
    "ugcAndCompetitorReferences": "網路蒐集資料只作選題、事實查證與風格參考，不複製他人照片、影音、文案或不實功效。引用來源須可追溯，與品牌自有商品資訊分開。"
  }
