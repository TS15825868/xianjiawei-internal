{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xianjiawei-internal",
  "main": "src/publishing-only-entry.js",
  "compatibility_date": "2026-07-24",
  "keep_vars": true,
  "vars": {
    "POLICY_AUD": "201dea08ea9611989cd8ad4ccac88f99974fd9b1309e4af74bf11a397ee6522f",
    "TEAM_DOMAIN": "https://tung314069.cloudflareaccess.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xianjiawei-internal-db",
      "database_id": "5e85d589-9c4f-412e-9ccd-585a5b6ecabe"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
