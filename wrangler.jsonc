{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xianjiawei-internal",
  "main": "src/authority-entry.js",
  "compatibility_date": "2026-07-24",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xianjiawei-internal-db",
      "database_id": "5e85d589-9c4f-412e-9ccd-585a5b6ecabe"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
