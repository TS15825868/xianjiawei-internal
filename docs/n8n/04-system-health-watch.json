      "position": [720, 0]
    },
    {
      "parameters": {
        "jsCode": "const web=$('讀官網正式母資料').first().json; const line=$('讀 LINE OA healthz').first().json; const gh=$('讀官網 GitHub Pages').first().json; const webBody=web.body??web; const lineBody=line.body??line; const ghBody=gh.body??gh; const latest=Array.isArray(ghBody.workflow_runs)?ghBody.workflow_runs[0]:null; const websiteOk=Number(web.statusCode??200)>=200&&Number(web.statusCode??200)<300&&webBody?.authority==='user-confirmed-current'&&Number(webBody?.productCount)===6; const lineStatus=Number(line.statusCode??line.status??0); const lineOk=lineStatus>=200&&lineStatus<300&&lineBody?.ok!==false; const githubStatus=Number(gh.statusCode??200); const githubOk=githubStatus>=200&&githubStatus<300&&!!latest&&latest.status==='completed'&&latest.conclusion==='success'; const problems=[]; if(!websiteOk) problems.push('官網正式產品母資料異常'); if(!lineOk) problems.push('LINE OA healthz 異常'); if(!githubOk) problems.push('官網 GitHub Pages 最新部署未成功'); return [{json:{ok:problems.length===0,checkedAt:new Date().toISOString(),website:{ok:websiteOk,status:web.statusCode??null,version:webBody?.version,productCount:webBody?.productCount},line:{ok:lineOk,status:lineStatus,bodyOk:lineBody?.ok},githubPages:{ok:githubOk,status:latest?.status,conclusion:latest?.conclusion,headSha:latest?.head_sha,runId:latest?.id},problems}}];"
      },
      "id": "xjw-health-005",
      "name": "總體判斷",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "xjw-health-cond", "leftValue": "={{$json.ok}}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"},
        "options": {}
      },
      "id": "xjw-health-006",
      "name": "全部正常？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 0]
    },
    {
      "parameters": {"jsCode": "return [{json:{...$json,message:'仙加味官網／LINE OA／GitHub Pages 目前正常'}}];"},
